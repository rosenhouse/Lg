<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.rosenhouse.lg</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/lg/bin/lg</string>
		<string>daemon</string>
		<string>run</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HTTPS_PROXY</key>
		<string>http://proxy.example:3128</string>
		<key>HTTP_PROXY</key>
		<string>http://proxy.example:3128</string>
		<key>LG_CONFIG</key>
		<string>/etc/lg/config.yaml</string>
		<key>LG_GH</key>
		<string>/opt/gh/bin/gh</string>
		<key>LG_HOME</key>
		<string>/srv/lg</string>
		<key>NO_PROXY</key>
		<string>localhost,.example</string>
		<key>SSL_CERT_FILE</key>
		<string>/etc/ssl/ca.pem</string>
		<key>https_proxy</key>
		<string>http://proxy.example:3128</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardErrorPath</key>
	<string>/srv/lg/state/daemon.log</string>
</dict>
</plist>
